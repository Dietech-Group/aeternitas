# This file contains sample rake tasks for maintaining your Aeternitas installation.
# It is recommended to run these tasks periodically (e.g., weekly) to prevent
# tables from growing indefinitely and to clean up stale data from crashed processes.
#
# You can uncomment the tasks you wish to use and schedule them with a tool like 'whenever'.

namespace :aeternitas do
  namespace :maintenance do
    desc "Clean up all stale Aeternitas data (locks and metrics)."
    task cleanup_all: :environment do
      puts "Running all Aeternitas maintenance tasks..."
      Rake::Task['aeternitas:maintenance:cleanup_stale_locks'].invoke
      Rake::Task['aeternitas:maintenance:cleanup_old_metrics'].invoke
      puts "Aeternitas maintenance complete."
    end

    desc "Clean up stale job and guard locks that have passed their expiration."
